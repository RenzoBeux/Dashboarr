@@ -267,6 +261,24 @@ function getRouteConfigSorter(previousSegments = []) {
         if (a.staticPartCount !== b.staticPartCount) {
             return b.staticPartCount - a.staticPartCount;
         }
+        /*
+         * NOTE(dashboarr): upstream runs this prefix rule BEFORE the type /
+         * staticPartCount rules above, which makes the comparator cyclic:
+         * a static route beats a dynamic one, the dynamic one beats its own
