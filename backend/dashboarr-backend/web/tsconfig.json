{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../../*"
      ],
      "@noble/ciphers/*": [
        "../node_modules/@noble/ciphers/*"
      ],
      "@noble/hashes/*": [
        "../node_modules/@noble/hashes/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../src/ui/overview-types.ts",
    "../../../store/config-schema.ts",
    "../../../store/config-migrations.ts",
    "../../../lib/config-crypto-core.ts",
    "../../../lib/config-defaults.ts",
    "../../../lib/service-catalog.ts",
    "../../../lib/url-validation.ts",
    "../../../lib/notification-categories.ts"
  ]
}
